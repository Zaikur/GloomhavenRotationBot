@page
@model SetupModel

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="m-0">Setup</h2>
        <div class="text-white-50">Discord connection settings</div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            @if (Model.HasToken)
            {
                <span class="badge bg-success">Token stored</span>
                <span class="text-white-50 small">Stored encrypted in SQLite. Leave the box blank to keep it.</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Token not set</span>
                <span class="text-white-50 small">Paste a bot token below and click Save.</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-@Model.MessageKind mb-3">@Model.Message</div>
        }

        <form method="post" asp-antiforgery="false" class="row g-3" asp-page-handler="SaveAi">
            <div class="col-12">
                <label class="form-label">Guild ID</label>
                <input class="form-control" name="GuildId" value="@Model.GuildId" />
            </div>

            <div class="col-12">
                <label class="form-label">Bot Token</label>
                <input class="form-control"
                       name="Token"
                       type="password"
                       value=""
                       placeholder="@(Model.HasToken ? "Token already set — leave blank to keep" : "Paste bot token")" />
            </div>

            <div class="col-12 form-check">
                <input class="form-check-input" type="checkbox" name="RegisterToGuild" value="true" @(Model.RegisterToGuild ? "checked" : "") />
                <label class="form-check-label">Register commands to this guild (fast updates)</label>
            </div>

            <hr class="border-secondary" />

            <h5 class="mb-1">Announcements</h5>
            <div class="text-white-50 small mb-3">Morning post about tonight’s session + assignments.</div>

            <div class="col-12">
                <label class="form-label">Announcement Channel ID</label>
                <input class="form-control" name="AnnounceChannelId" value="@Model.AnnounceChannelId" />
                <div class="form-text text-white-50">
                    Enable Developer Mode in Discord → right-click the channel → Copy ID
                </div>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Announcement time</label>
                <input class="form-control" type="time" name="AnnounceTime" value="@Model.AnnounceTime" />
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button class="btn btn-outline-info" type="submit" asp-page-handler="TestAnnouncement">
                    Test morning announcement
                </button>
            </div>
            <div class="form-text text-white-50">
                Sends a test message to the configured announcement channel
            </div>

            <hr class="border-secondary" />

            <h5 class="mb-1">Auto-advance</h5>
            <div class="text-white-50 small mb-3">
                Automatically advances DM/Food after session start time if not cancelled.
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Advance minutes after start</label>
                <input class="form-control" type="number" min="0" max="1440" name="AutoAdvanceMinutesAfterStart" value="@Model.AutoAdvanceMinutesAfterStart" />
                <div class="form-text text-white-50">Example: 60 means advance one hour after start.</div>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Save</button>

                <button class="btn btn-outline-info"
                        type="submit"
                        asp-page-handler="Test">
                    Test
                </button>

                <a class="btn btn-outline-secondary" href="/Rosters">Rosters</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <h5 class="mb-1">AI responses</h5>
        <div class="text-white-50 small mb-3">Configure how the bot generates replies, announcements, and birthday wishes.</div>

        <form method="post" asp-antiforgery="false" class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">Provider</label>
                <select class="form-select" asp-for="AiProvider">
                    <option value="">Default (OpenAI-compatible)</option>
                    <option value="openai">OpenAI</option>
                    <option value="ollama">Ollama (local)</option>
                    <option value="custom">Custom</option>
                </select>
                <div class="form-text text-white-50">Choose Ollama for local models (e.g., http://localhost:11434/v1/chat/completions).</div>
            </div>

            <div class="col-12">
                <label class="form-label">Endpoint URL</label>
                <input class="form-control" name="AiEndpoint" value="@Model.AiEndpoint" placeholder="https://api.openai.com/v1/chat/completions" />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Model name</label>
                <input class="form-control" name="AiModel" value="@Model.AiModel" placeholder="gpt-3.5-turbo or llama3" />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">API key (optional)</label>
                <input class="form-control" name="AiApiKey" type="password" value="" placeholder="Leave blank to keep existing" />
                <div class="form-text text-white-50">For Ollama/local models, leave blank.</div>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Save AI settings</button>
            </div>

        <hr class="border-secondary" />

        <h6 class="mt-2 mb-1">Weather (for announcements and replies)</h6>
        <div class="text-white-50 small mb-3">Optional: provide coordinates to let the bot mention the daily forecast.</div>

            <div class="col-12 col-md-4">
                <label class="form-label">Latitude</label>
                <input class="form-control" name="WeatherLatitude" value="@Model.WeatherLatitude" placeholder="41.8781" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Longitude</label>
                <input class="form-control" name="WeatherLongitude" value="@Model.WeatherLongitude" placeholder="-87.6298" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Units</label>
                <select class="form-select" asp-for="WeatherUnits">
                    <option value="imperial">Imperial (F)</option>
                    <option value="metric">Metric (C)</option>
                </select>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Save weather settings</button>
                <div class="text-white-50 small">Uses open-meteo.com (no API key required). Leave blank to disable.</div>
            </div>
        </form>
    </div>
</div>
