@page
@model TranscriptModel

<style>
    .transcript-shell {
        display: flex;
        flex-direction: column;
        height: 68vh;
        border: 1px solid rgba(255, 255, 255, .1);
        border-radius: .75rem;
        background: linear-gradient(180deg, rgba(255, 255, 255, .03), rgba(255, 255, 255, .01));
        overflow: hidden;
    }

    .transcript-feed {
        flex: 1;
        overflow-y: auto;
        padding: .9rem;
        display: flex;
        flex-direction: column;
        gap: .7rem;
    }

    .transcript-empty {
        color: rgba(255, 255, 255, .65);
        text-align: center;
        padding: 2rem 1rem;
    }

    .chat-row {
        display: flex;
        align-items: flex-start;
        gap: .6rem;
    }

    .chat-time {
        width: 72px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: rgba(255, 255, 255, .55);
        font-size: .75rem;
        line-height: 1.6;
        flex-shrink: 0;
    }

    .chat-bubble {
        max-width: min(100%, 900px);
        background: rgba(17, 24, 39, .9);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: .8rem;
        padding: .55rem .75rem;
    }

    .chat-speaker {
        font-weight: 600;
        color: #9fd7ff;
        margin-bottom: .2rem;
        font-size: .88rem;
    }

    .chat-text {
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 1.35;
    }

    .mapping-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: .75rem;
    }

    .mapping-card {
        border: 1px solid rgba(255, 255, 255, .1);
        border-radius: .6rem;
        padding: .65rem;
        background: rgba(255, 255, 255, .03);
    }

    .mic-stats {
        border: 1px solid rgba(255, 255, 255, .12);
        border-radius: .5rem;
        background: rgba(255, 255, 255, .03);
        padding: .5rem .65rem;
    }

    .mic-stats .label {
        color: rgba(255, 255, 255, .7);
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .mic-stats .value {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 600;
    }
</style>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="m-0">Transcript</h2>
        <div class="text-white-50">Browser mic upload + transcription + speaker mapping</div>
    </div>
    <div class="text-white-50 small text-md-end">
        <div>Active session:</div>
        @if (Model.ActiveSession is null)
        {
            <span class="badge text-bg-secondary">none</span>
        }
        else
        {
            <span class="badge text-bg-success">@Model.ActiveSession.SessionId</span>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="alert alert-@Model.FlashKind">@Model.FlashMessage</div>
}

<div class="row g-3">
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Session Control</h5>
                <p class="text-white-50 small">Recording audio requires this page to stay open while laptop mic streaming is active.</p>

                <form id="startSessionForm" method="post" asp-page-handler="Start" asp-antiforgery="false" class="row g-2 mb-2">
                    <div class="col-12">
                        <label class="form-label">Expected speakers</label>
                        <input class="form-control" id="expectedSpeakersInput" type="number" min="1" max="12" name="ExpectedSpeakers" value="@Model.ExpectedSpeakers" />
                        <div class="form-text text-white-50">Use number of players physically present.</div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary w-100" id="startRecordingBtn" type="button">Start Recording</button>
                    </div>
                </form>

                <div class="mt-2 d-grid gap-2">
                    <button class="btn btn-outline-secondary" id="pauseRecordingBtn" type="button" disabled>Pause</button>
                    <button class="btn btn-outline-warning" id="stopRecordingBtn" type="button" @(Model.ActiveSession is null ? "disabled" : null)>Stop + Process</button>
                    <div class="small text-white-50" id="browserMicStatus">Laptop mic idle.</div>
                    <div class="mic-stats">
                        <div class="d-flex justify-content-between"><span class="label">Recording Elapsed</span><span class="value" id="recordingElapsed">00:00:00</span></div>
                        <div class="d-flex justify-content-between"><span class="label">Next Chunk In</span><span class="value" id="nextChunkCountdown">--:--</span></div>
                    </div>
                </div>

                <hr class="border-secondary" />

                <h6>Transcription Command</h6>
                <p class="text-white-50 small mb-2">
                    Placeholders: <code>{input}</code>, <code>{output}</code>, <code>{speakers}</code>, <code>{sessionId}</code>
                </p>

                <form method="post" asp-page-handler="SaveConfig" asp-antiforgery="false" class="row g-2">
                    <input type="hidden" name="sessionId" value="@Model.SelectedSessionId" />
                    <div class="col-12">
                        <label class="form-label">Command template</label>
                        <textarea class="form-control font-monospace" name="CommandTemplate" rows="6">@Model.CommandTemplate</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Transcript storage path</label>
                        <input class="form-control" name="RootPath" value="@Model.RootPath" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-info w-100" type="submit">Save Transcription Settings</button>
                    </div>
                </form>

                <div class="text-white-50 small mt-2">
                    Recommended local command:<br />
                    <code>python -m whisperx {input} --model medium --language en --diarize --min_speakers {speakers} --max_speakers {speakers} --output_dir {output}</code>
                </div>

                <hr class="border-secondary" />

                <h6>AI Models</h6>
                <p class="text-white-50 small mb-2">
                    WhisperX downloads the Whisper transcription model and the diarization model on first use, which can take several minutes. Pre-download them here so the first session doesn't stall.
                </p>
                @{
                    var cacheState = Model.ModelCacheState;
                    var isReady = cacheState == GameplayTranscriptionService.ModelCacheState.Ready;
                    var isDownloading = cacheState == GameplayTranscriptionService.ModelCacheState.Downloading;
                }
                @if (!string.IsNullOrWhiteSpace(Model.ModelDownloadError))
                {
                    <div class="alert alert-warning small py-1 px-2 mb-2">@Model.ModelDownloadError</div>
                }
                <div class="d-flex align-items-center gap-2">
                    <button id="downloadModelsBtn" type="button"
                            class="btn @(isReady ? "btn-outline-secondary" : "btn-outline-success") flex-grow-1"
                            @(isReady || isDownloading ? "disabled" : null)>
                        @if (isReady)
                        {
                            <span>Models Downloaded</span>
                        }
                        else if (isDownloading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Downloading…</span>
                        }
                        else
                        {
                            <span>Download Models</span>
                        }
                    </button>
                    <button id="redownloadModelsBtn" type="button"
                            class="btn btn-outline-warning"
                            @(isDownloading ? "disabled" : null)>
                        Re-download
                    </button>
                    <span id="modelStatusText" class="small text-white-50">
                        @(isReady ? "Ready" : isDownloading ? "In progress" : cacheState == GameplayTranscriptionService.ModelCacheState.Failed ? "Failed" : "Not cached")
                    </span>
                </div>
                <div class="text-white-50 small mt-2">
                    Re-download refreshes the model cache and can recover from partial or corrupted model files.
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h5 class="card-title">Recent Sessions</h5>
                @if (Model.Sessions.Count == 0)
                {
                    <div class="text-white-50 small">No transcript sessions yet.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var s in Model.Sessions)
                        {
                            <a class="list-group-item list-group-item-action @(s.SessionId == Model.SelectedSessionId ? "active" : "") js-session-link"
                               href="/Transcript?sessionId=@s.SessionId">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@s.SessionId</div>
                                        <div class="small">Speakers: @s.ExpectedSpeakers</div>
                                    </div>
                                    <span class="badge text-bg-secondary">@s.Status</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h5 class="card-title">Speaker Mapping</h5>
                @if (Model.SelectedSession is null)
                {
                    <div class="text-white-50 small">Select a session to map speakers.</div>
                }
                else if (Model.Speakers.Count == 0)
                {
                    <div id="speakerMappingGrid" class="text-white-50 small">No diarized speakers yet for this session.</div>
                }
                else
                {
                    <div class="mapping-grid" id="speakerMappingGrid">
                        @foreach (var speaker in Model.Speakers)
                        {
                            var assignment = Model.SpeakerAssignments.TryGetValue(speaker, out var a) ? a : null;
                            <form method="post" asp-page-handler="AssignSpeaker" asp-antiforgery="false" class="mapping-card js-mapping-form">
                                <input type="hidden" name="sessionId" value="@Model.SelectedSessionId" />
                                <input type="hidden" name="speaker" value="@speaker" />

                                <label class="form-label mb-1"><strong>@speaker</strong></label>
                                <div class="d-flex gap-2">
                                    <select class="form-select" name="playerId">
                                        <option value="">Unassigned</option>
                                        @foreach (var member in Model.GuildMembers)
                                        {
                                            if (assignment?.PlayerId == member.Id)
                                            {
                                                <option value="@member.Id" selected>@member.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@member.Id">@member.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </form>
                        }
                    </div>
                }

                <select id="playerOptionsTemplate" class="d-none" aria-hidden="true" tabindex="-1">
                    <option value="">Unassigned</option>
                    @foreach (var member in Model.GuildMembers)
                    {
                        <option value="@member.Id">@member.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="card-title m-0">Transcript Output</h5>
                    @if (Model.SelectedSession != null)
                    {
                        <span class="badge text-bg-secondary" id="sessionStatusBadge">@Model.SelectedSession.Status</span>
                    }
                </div>

                <div class="alert alert-warning d-flex align-items-start justify-content-between gap-2 @(Model.SelectedSession?.Error is { Length: > 0 } ? "" : "d-none")" id="sessionErrorBanner">
                    <div class="flex-grow-1" id="sessionErrorText">@Model.SelectedSession?.Error</div>
                    <button type="button" class="btn btn-sm btn-outline-dark" id="copySessionErrorBtn">Copy</button>
                </div>

                <div class="transcript-shell">
                    <div class="transcript-feed" id="transcriptFeed">
                        @if (Model.Segments.Count == 0)
                        {
                            <div class="transcript-empty" id="transcriptEmpty">No transcript segments available yet.</div>
                        }
                        else
                        {
                            @foreach (var segment in Model.Segments)
                            {
                                var displaySpeaker = Model.DisplaySpeaker(segment.Speaker);
                                <div class="chat-row">
                                    <div class="chat-time">@TimeSpan.FromSeconds(segment.StartSeconds).ToString(@"hh\:mm\:ss")</div>
                                    <div class="chat-bubble">
                                        <div class="chat-speaker">@displaySpeaker</div>
                                        <div class="chat-text">@segment.Text</div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        let selectedSessionId = '@Model.SelectedSessionId';
        let activeSessionId = '@Model.ActiveSession?.SessionId';
        const chunkSeconds = @GloomhavenRotationBot.Services.GameplayTranscriptionService.ChunkSeconds;

        const feed = document.getElementById('transcriptFeed');
        const statusBadge = document.getElementById('sessionStatusBadge');
        const errorBanner = document.getElementById('sessionErrorBanner');
        const errorText = document.getElementById('sessionErrorText');
        const copySessionErrorBtn = document.getElementById('copySessionErrorBtn');
        const mappingGrid = document.getElementById('speakerMappingGrid');
        const optionsTemplateElement = document.getElementById('playerOptionsTemplate');
        const memberOptionsTemplate = optionsTemplateElement ? optionsTemplateElement.innerHTML : '<option value="">Unassigned</option>';
        const startSessionForm = document.getElementById('startSessionForm');
        const expectedSpeakersInput = document.getElementById('expectedSpeakersInput');
        const startRecordingBtn = document.getElementById('startRecordingBtn');
        const pauseRecordingBtn = document.getElementById('pauseRecordingBtn');
        const stopRecordingBtn = document.getElementById('stopRecordingBtn');

        // ── Model download ─────────────────────────────────────────────────────
        const downloadModelsBtn = document.getElementById('downloadModelsBtn');
        const redownloadModelsBtn = document.getElementById('redownloadModelsBtn');
        const modelStatusText = document.getElementById('modelStatusText');
        let modelPollHandle = null;

        function setModelBtnReady() {
            if (downloadModelsBtn) {
                downloadModelsBtn.disabled = true;
                downloadModelsBtn.className = 'btn btn-outline-secondary flex-grow-1';
                downloadModelsBtn.innerHTML = '<span>Models Downloaded</span>';
            }
            if (redownloadModelsBtn) {
                redownloadModelsBtn.disabled = false;
            }
            if (modelStatusText) modelStatusText.textContent = 'Ready';
            if (modelPollHandle) { clearInterval(modelPollHandle); modelPollHandle = null; }
        }

        function setModelBtnDownloading() {
            if (downloadModelsBtn) {
                downloadModelsBtn.disabled = true;
                downloadModelsBtn.className = 'btn btn-outline-secondary flex-grow-1';
                downloadModelsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Downloading\u2026</span>';
            }
            if (redownloadModelsBtn) {
                redownloadModelsBtn.disabled = true;
            }
            if (modelStatusText) modelStatusText.textContent = 'In progress';
        }

        function setModelButtonsIdle() {
            if (downloadModelsBtn) {
                downloadModelsBtn.disabled = false;
                downloadModelsBtn.className = 'btn btn-outline-success flex-grow-1';
                downloadModelsBtn.innerHTML = '<span>Download Models</span>';
            }
            if (redownloadModelsBtn) {
                redownloadModelsBtn.disabled = false;
            }
        }

        async function pollModelStatus() {
            try {
                const r = await fetch('/Transcript?handler=ModelStatus', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!r.ok) return;
                const d = await r.json();
                if (d.state === 'Ready') {
                    setModelBtnReady();
                } else if (d.state === 'Downloading') {
                    setModelBtnDownloading();
                } else if (d.state === 'Failed') {
                    if (downloadModelsBtn) {
                        downloadModelsBtn.disabled = false;
                        downloadModelsBtn.className = 'btn btn-outline-danger flex-grow-1';
                        downloadModelsBtn.innerHTML = '<span>Retry Download</span>';
                    }
                    if (redownloadModelsBtn) {
                        redownloadModelsBtn.disabled = false;
                    }
                    if (modelStatusText) modelStatusText.textContent = d.error || 'Failed';
                    if (modelPollHandle) { clearInterval(modelPollHandle); modelPollHandle = null; }
                } else {
                    setModelButtonsIdle();
                    if (modelStatusText) modelStatusText.textContent = 'Not cached';
                    if (modelPollHandle) { clearInterval(modelPollHandle); modelPollHandle = null; }
                }
            } catch { /* ignore */ }
        }

        async function startModelDownload(force) {
            setModelBtnDownloading();
            try {
                const url = force
                    ? '/Transcript?handler=DownloadModels&force=true'
                    : '/Transcript?handler=DownloadModels';
                await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': document.querySelector('meta[name="csrf-token"]')?.content ?? '' }
                });
            } catch {
                setModelButtonsIdle();
            }

            if (modelPollHandle) {
                clearInterval(modelPollHandle);
            }
            modelPollHandle = setInterval(pollModelStatus, 3000);
        }

        if (downloadModelsBtn) {
            downloadModelsBtn.addEventListener('click', async () => {
                await startModelDownload(false);
            });

            // If a download was already in progress when the page loaded, start polling.
            if (downloadModelsBtn.disabled && modelStatusText && modelStatusText.textContent.trim() === 'In progress') {
                modelPollHandle = setInterval(pollModelStatus, 3000);
            }
        }

        if (redownloadModelsBtn) {
            redownloadModelsBtn.addEventListener('click', async () => {
                await startModelDownload(true);
            });
        }
        const browserMicStatus = document.getElementById('browserMicStatus');
        const recordingElapsed = document.getElementById('recordingElapsed');
        const nextChunkCountdown = document.getElementById('nextChunkCountdown');

        let mediaStream = null;
        let mediaRecorder = null;
        let recorderStopPromise = null;
        let recorderStopResolve = null;
        let isPaused = false;
        let pauseStartedAt = 0;
        let pausedAccumulatedMs = 0;
        let timerHandle = null;
        let recordingStartedAt = 0;
        let nextChunkDueAt = 0;
        let pendingUploads = 0;
        let chunkCounter = 0;
        let uploadChain = Promise.resolve();
        let lastChunkSize = 0;

        const renderTime = (seconds) => {
            const total = Math.max(0, Math.floor(seconds));
            const hh = String(Math.floor(total / 3600)).padStart(2, '0');
            const mm = String(Math.floor((total % 3600) / 60)).padStart(2, '0');
            const ss = String(total % 60).padStart(2, '0');
            return `${hh}:${mm}:${ss}`;
        };

        const isNearBottom = () => {
            if (!feed) return false;
            const distance = feed.scrollHeight - feed.scrollTop - feed.clientHeight;
            return distance < 120;
        };

        const scrollToBottom = () => {
            if (feed) {
                feed.scrollTop = feed.scrollHeight;
            }
        };

        const renderSegments = (segments) => {
            if (!feed) return;

            const shouldStickBottom = isNearBottom();
            feed.innerHTML = '';

            if (!segments || segments.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'transcript-empty';
                empty.id = 'transcriptEmpty';
                empty.textContent = 'No transcript segments available yet.';
                feed.appendChild(empty);
            } else {
                for (const segment of segments) {
                    const row = document.createElement('div');
                    row.className = 'chat-row';

                    const time = document.createElement('div');
                    time.className = 'chat-time';
                    time.textContent = renderTime(segment.startSeconds || 0);

                    const bubble = document.createElement('div');
                    bubble.className = 'chat-bubble';

                    const speaker = document.createElement('div');
                    speaker.className = 'chat-speaker';
                    speaker.textContent = segment.displaySpeaker || segment.speaker || 'Speaker';

                    const text = document.createElement('div');
                    text.className = 'chat-text';
                    text.textContent = segment.text || '';

                    bubble.appendChild(speaker);
                    bubble.appendChild(text);
                    row.appendChild(time);
                    row.appendChild(bubble);
                    feed.appendChild(row);
                }
            }

            if (shouldStickBottom) {
                scrollToBottom();
            }
        };

        const renderMappings = (speakers) => {
            if (!mappingGrid) return;

            if (!speakers || speakers.length === 0) {
                mappingGrid.className = 'text-white-50 small';
                mappingGrid.innerHTML = '<div class="text-white-50 small">No diarized speakers yet for this session.</div>';
                return;
            }

            mappingGrid.className = 'mapping-grid';
            mappingGrid.innerHTML = '';
            for (const speaker of speakers) {
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '/Transcript?handler=AssignSpeaker';
                form.className = 'mapping-card js-mapping-form';

                const inputSession = document.createElement('input');
                inputSession.type = 'hidden';
                inputSession.name = 'sessionId';
                inputSession.value = selectedSessionId;

                const inputSpeaker = document.createElement('input');
                inputSpeaker.type = 'hidden';
                inputSpeaker.name = 'speaker';
                inputSpeaker.value = speaker.speaker;

                const label = document.createElement('label');
                label.className = 'form-label mb-1';
                label.innerHTML = `<strong>${speaker.speaker}</strong>`;

                const wrap = document.createElement('div');
                wrap.className = 'd-flex gap-2';

                const select = document.createElement('select');
                select.className = 'form-select';
                select.name = 'playerId';
                select.innerHTML = '<option value="">Unassigned</option>' + memberOptionsTemplate;
                if (speaker.assignedPlayerId) {
                    select.value = String(speaker.assignedPlayerId);
                }

                select.addEventListener('change', () => {
                    submitMappingForm(form);
                });

                wrap.appendChild(select);
                form.appendChild(inputSession);
                form.appendChild(inputSpeaker);
                form.appendChild(label);
                form.appendChild(wrap);
                mappingGrid.appendChild(form);
            }
        };

        const updateStatus = (payload) => {
            if (statusBadge && payload.status) {
                statusBadge.textContent = payload.status;
            }

            if (payload.isActive) {
                activeSessionId = payload.sessionId || activeSessionId;
                selectedSessionId = payload.sessionId || selectedSessionId;
            } else if (payload.sessionId && activeSessionId === payload.sessionId && payload.status && payload.status.startsWith('Completed')) {
                activeSessionId = '';
            }

            if (payload.status && (payload.status.startsWith('Completed') || payload.status === 'Failed')) {
                stopBrowserMic().catch(() => {
                    // Ignore stop errors during live status updates.
                });
            }

            if (!errorBanner) return;

            if (payload.error) {
                errorBanner.classList.remove('d-none');
                if (errorText) {
                    errorText.textContent = payload.error;
                }

                if (copySessionErrorBtn) {
                    copySessionErrorBtn.disabled = false;
                }
            } else {
                errorBanner.classList.add('d-none');
                if (errorText) {
                    errorText.textContent = '';
                }

                if (copySessionErrorBtn) {
                    copySessionErrorBtn.disabled = true;
                }
            }
        };

        const refreshLive = async () => {
            if (!selectedSessionId) {
                return;
            }

            try {
                const response = await fetch(`/Transcript?handler=Live&sessionId=${encodeURIComponent(selectedSessionId)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!response.ok) return;

                const payload = await response.json();
                updateStatus(payload);
                renderMappings(payload.speakers || []);
                renderSegments(payload.segments || []);
            } catch {
                // Ignore intermittent polling errors.
            }
        };

        const setBrowserStatus = (text) => {
            if (browserMicStatus) {
                browserMicStatus.textContent = text;
            }
        };

        const describeBytes = (bytes) => {
            if (!Number.isFinite(bytes) || bytes <= 0) {
                return '0 B';
            }

            if (bytes < 1024) {
                return `${bytes} B`;
            }

            if (bytes < 1024 * 1024) {
                return `${(bytes / 1024).toFixed(1)} KB`;
            }

            return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
        };

        const renderShortTime = (seconds) => {
            const total = Math.max(0, Math.floor(seconds));
            const mm = String(Math.floor(total / 60)).padStart(2, '0');
            const ss = String(total % 60).padStart(2, '0');
            return `${mm}:${ss}`;
        };

        const updateMicTimers = () => {
            if (!recordingElapsed || !nextChunkCountdown) {
                return;
            }

            if (!recordingStartedAt) {
                recordingElapsed.textContent = '00:00:00';
                nextChunkCountdown.textContent = '--:--';
                return;
            }

            const now = Date.now();
            const pausedMs = isPaused && pauseStartedAt
                ? (now - pauseStartedAt)
                : 0;
            const elapsedMs = Math.max(0, (now - recordingStartedAt) - pausedAccumulatedMs - pausedMs);
            recordingElapsed.textContent = renderTime(elapsedMs / 1000);

            if (isPaused) {
                nextChunkCountdown.textContent = 'paused';
                return;
            }

            const remaining = Math.max(0, (nextChunkDueAt - now) / 1000);
            nextChunkCountdown.textContent = renderShortTime(remaining);
        };

        const stopTimerLoop = () => {
            if (timerHandle) {
                window.clearInterval(timerHandle);
                timerHandle = null;
            }

            recordingStartedAt = 0;
            nextChunkDueAt = 0;
            pausedAccumulatedMs = 0;
            pauseStartedAt = 0;
            isPaused = false;
            updateMicTimers();
        };

        const startTimerLoop = () => {
            recordingStartedAt = Date.now();
            nextChunkDueAt = recordingStartedAt + (chunkSeconds * 1000);
            pausedAccumulatedMs = 0;
            pauseStartedAt = 0;
            isPaused = false;
            updateMicTimers();

            if (timerHandle) {
                window.clearInterval(timerHandle);
            }

            timerHandle = window.setInterval(updateMicTimers, 250);
        };

        const setBrowserButtons = (isRecording) => {
            if (startRecordingBtn) {
                startRecordingBtn.disabled = isRecording;
            }

            if (pauseRecordingBtn) {
                pauseRecordingBtn.disabled = !isRecording;
                pauseRecordingBtn.textContent = isPaused ? 'Resume' : 'Pause';
            }

            if (stopRecordingBtn) {
                stopRecordingBtn.disabled = !isRecording;
            }
        };

        const uploadChunk = async (blob) => {
            if (!(blob instanceof Blob) || blob.size === 0) {
                setBrowserStatus('Skipped an empty audio chunk.');
                return;
            }

            lastChunkSize = blob.size;

            const fd = new FormData();
            const fileName = `chunk-${String(chunkCounter).padStart(5, '0')}.webm`;
            chunkCounter += 1;

            fd.append('sessionId', selectedSessionId);
            fd.append('audioChunk', blob, fileName);

            const response = await fetch('/Transcript?handler=UploadChunk', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) {
                let msg = `Upload failed (${response.status}).`;
                try {
                    const json = await response.json();
                    if (json && json.message) {
                        msg = json.message;
                    }
                } catch {
                    // Keep generic error message.
                }

                throw new Error(msg);
            }

            nextChunkDueAt = Date.now() + (chunkSeconds * 1000);
            setBrowserStatus(`Uploaded chunk ${String(chunkCounter - 1).padStart(5, '0')} (${describeBytes(lastChunkSize)}).`);
        };

        const enqueueUpload = (blob) => {
            pendingUploads += 1;
            uploadChain = uploadChain
                .then(() => uploadChunk(blob))
                .catch((err) => {
                    setBrowserStatus(`Mic upload error: ${err.message || 'unknown error'}`);
                })
                .finally(() => {
                    pendingUploads = Math.max(0, pendingUploads - 1);
                });

            return uploadChain;
        };

        const waitForRecorderStop = async () => {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                return;
            }

            if (!recorderStopPromise) {
                recorderStopPromise = new Promise((resolve) => {
                    recorderStopResolve = resolve;
                });
            }

            mediaRecorder.stop();
            await recorderStopPromise;
        };

        const ensureSessionStarted = async () => {
            if (!activeSessionId && selectedSessionId) {
                await refreshLive();
            }

            if (activeSessionId) {
                selectedSessionId = activeSessionId;
                return;
            }

            const expected = Number(expectedSpeakersInput?.value ?? '4');
            const fd = startSessionForm
                ? new FormData(startSessionForm)
                : new FormData();

            fd.set('ExpectedSpeakers', String(Number.isFinite(expected) ? expected : 4));

            const response = await fetch('/Transcript?handler=Start', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const payload = await response.json().catch(() => ({ ok: false, message: `Start failed (${response.status}).` }));
            if (!response.ok || !payload.ok) {
                throw new Error(payload.message || `Start failed (${response.status}).`);
            }

            activeSessionId = payload.sessionId || activeSessionId;
            selectedSessionId = activeSessionId;
        };

        const stopSessionOnServer = async () => {
            const fd = new FormData();
            if (selectedSessionId) {
                fd.append('sessionId', selectedSessionId);
            }

            const response = await fetch('/Transcript?handler=Stop', {
                method: 'POST',
                body: fd,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            const payload = await response.json().catch(() => ({ ok: false, message: `Stop failed (${response.status}).` }));
            if (!response.ok || !payload.ok) {
                throw new Error(payload.message || `Stop failed (${response.status}).`);
            }

            selectedSessionId = payload.sessionId || selectedSessionId;
            activeSessionId = '';
        };

        const startBrowserMic = async () => {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof MediaRecorder === 'undefined') {
                setBrowserStatus('This browser does not support microphone capture uploads.');
                return;
            }

            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                return;
            }

            const preferredMime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
                ? 'audio/webm;codecs=opus'
                : (MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : '');

            try {
                mediaStream = await navigator.mediaDevices.getUserMedia({
                    audio: {
                        channelCount: 1,
                        echoCancellation: true,
                        noiseSuppression: true,
                        autoGainControl: true
                    }
                });
                mediaRecorder = preferredMime
                    ? new MediaRecorder(mediaStream, { mimeType: preferredMime })
                    : new MediaRecorder(mediaStream);

                mediaRecorder.ondataavailable = (evt) => {
                    if (evt.data && evt.data.size > 0) {
                        enqueueUpload(evt.data);
                    } else {
                        setBrowserStatus('Recorder produced a zero-byte chunk.');
                    }
                };

                mediaRecorder.onstop = () => {
                    if (recorderStopResolve) {
                        recorderStopResolve();
                        recorderStopResolve = null;
                    }

                    setBrowserButtons(false);
                    setBrowserStatus(pendingUploads > 0
                        ? `Laptop mic stopped. Uploading ${pendingUploads} pending chunk(s)...`
                        : `Laptop mic stopped. Last chunk size: ${describeBytes(lastChunkSize)}.`);

                    stopTimerLoop();
                    mediaRecorder = null;
                };

                mediaRecorder.onpause = () => {
                    isPaused = true;
                    pauseStartedAt = Date.now();
                    setBrowserStatus('Recording paused.');
                    setBrowserButtons(true);
                    updateMicTimers();
                };

                mediaRecorder.onresume = () => {
                    if (pauseStartedAt) {
                        pausedAccumulatedMs += Math.max(0, Date.now() - pauseStartedAt);
                    }

                    pauseStartedAt = 0;
                    isPaused = false;
                    nextChunkDueAt = Date.now() + (chunkSeconds * 1000);
                    setBrowserStatus('Recording resumed.');
                    setBrowserButtons(true);
                    updateMicTimers();
                };

                mediaRecorder.onerror = (evt) => {
                    const detail = evt?.error?.message || evt?.error?.name || 'unknown MediaRecorder error';
                    setBrowserStatus(`Mic capture error: ${detail}`);
                };

                mediaRecorder.start(chunkSeconds * 1000);
                isPaused = false;
                setBrowserButtons(true);
                setBrowserStatus(`Laptop mic recording and streaming ${chunkSeconds}s chunks...`);
                recorderStopPromise = null;
                recorderStopResolve = null;
                startTimerLoop();
            } catch (err) {
                setBrowserButtons(false);
                setBrowserStatus(`Could not start laptop mic: ${err.message || 'permission denied'}`);
                stopTimerLoop();
            }
        };

        const stopBrowserMic = async () => {
            await waitForRecorderStop();

            if (mediaStream) {
                mediaStream.getTracks().forEach((track) => track.stop());
                mediaStream = null;
            }

            await uploadChain;
            setBrowserStatus('Laptop mic stopped. All chunks uploaded.');
            setBrowserButtons(false);
        };

        const togglePause = () => {
            if (!mediaRecorder || mediaRecorder.state === 'inactive') {
                return;
            }

            if (mediaRecorder.state === 'recording') {
                mediaRecorder.pause();
            } else if (mediaRecorder.state === 'paused') {
                mediaRecorder.resume();
            }
        };

        const startWorkflow = async () => {
            try {
                setBrowserStatus('Starting session...');
                setBrowserButtons(true);
                await ensureSessionStarted();
                await startBrowserMic();
                await refreshLive();
            } catch (err) {
                setBrowserStatus(`Could not start recording: ${err.message || 'unknown error'}`);
                setBrowserButtons(false);
            }
        };

        const stopWorkflow = async () => {
            try {
                setBrowserStatus('Stopping mic and waiting for pending uploads...');
                if (pauseRecordingBtn) pauseRecordingBtn.disabled = true;
                if (stopRecordingBtn) stopRecordingBtn.disabled = true;
                if (startRecordingBtn) startRecordingBtn.disabled = true;

                await stopBrowserMic();
                setBrowserStatus('All chunks uploaded. Processing final transcript...');
                await stopSessionOnServer();
                setBrowserStatus('Session stopped and processing complete.');
                await refreshLive();

                if (selectedSessionId) {
                    window.location.href = `/Transcript?sessionId=${encodeURIComponent(selectedSessionId)}`;
                }
            } catch (err) {
                setBrowserStatus(`Could not stop recording: ${err.message || 'unknown error'}`);
                setBrowserButtons(mediaRecorder && mediaRecorder.state !== 'inactive');
            }
        };

        const submitMappingForm = async (form) => {
            const data = new FormData(form);
            try {
                await fetch('/Transcript?handler=AssignSpeaker', {
                    method: 'POST',
                    body: data,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                await refreshLive();
            } catch {
                // Ignore and keep existing mapping state.
            }
        };

        document.querySelectorAll('.js-mapping-form').forEach((form) => {
            const select = form.querySelector('select[name="playerId"]');
            if (select) {
                select.addEventListener('change', () => submitMappingForm(form));
            }
        });

        if (startRecordingBtn) {
            startRecordingBtn.addEventListener('click', async () => {
                await startWorkflow();
            });
        }

        if (pauseRecordingBtn) {
            pauseRecordingBtn.addEventListener('click', () => {
                togglePause();
            });
        }

        if (stopRecordingBtn) {
            stopRecordingBtn.addEventListener('click', async () => {
                await stopWorkflow();
            });
        }

        if (copySessionErrorBtn) {
            copySessionErrorBtn.addEventListener('click', async () => {
                const message = (errorText?.textContent || '').trim();
                if (!message) {
                    return;
                }

                try {
                    await navigator.clipboard.writeText(message);
                    setBrowserStatus('Session error copied to clipboard.');
                } catch {
                    setBrowserStatus('Could not copy error text. Clipboard access was denied.');
                }
            });
        }

        const initiallyRecording = Boolean(activeSessionId);
        setBrowserButtons(initiallyRecording);
        stopTimerLoop();

        scrollToBottom();
        refreshLive();
        window.setInterval(refreshLive, 3500);
    })();
</script>
