@page
@model TranscriptHistoryModel
@{
    var monthLabel = Model.MonthFirst.ToDateTime(new TimeOnly(0, 0)).ToString("MMMM yyyy");
    var prev = Model.MonthFirst.AddMonths(-1);
    var next = Model.MonthFirst.AddMonths(1);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="m-0">Transcript History</h2>
        <div class="text-white-50">Browse past transcript sessions by date and scheduled game day</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="/TranscriptHistory?year=@prev.Year&month=@prev.Month">← Prev</a>
        <a class="btn btn-outline-secondary" href="/TranscriptHistory">Today</a>
        <a class="btn btn-outline-secondary" href="/TranscriptHistory?year=@next.Year&month=@next.Month">Next →</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">Jump to date</label>
                <input class="form-control" type="date" name="Date" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filter</button>
            </div>
            <div class="col-12 col-md-2">
                <a class="btn btn-outline-secondary w-100" href="/TranscriptHistory?year=@Model.MonthFirst.Year&month=@Model.MonthFirst.Month">Clear</a>
            </div>
            <div class="col-12 col-md-4 text-white-50 small">
                Time zone: @Model.TimeZone.Id
            </div>
        </form>
    </div>
</div>

@if (Model.Days.Count == 0)
{
    <div class="alert alert-info">No transcript sessions found for @monthLabel.</div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var day in Model.Days)
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <div>
                            <h5 class="m-0">@day.Date.ToString("dddd, MMM d, yyyy")</h5>
                            <div class="text-white-50 small">@day.Transcripts.Count transcript session(s)</div>
                        </div>
                        <a class="btn btn-sm btn-outline-info" href="/Calendar?year=@day.Date.Year&month=@day.Date.Month">Open in Calendar</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-5">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-2">Scheduled Sessions</h6>
                                @if (day.ScheduledSessions.Count == 0)
                                {
                                    <div class="text-white-50 small">No scheduled game sessions found on this date.</div>
                                }
                                else
                                {
                                    <ul class="mb-0 ps-3">
                                        @foreach (var scheduled in day.ScheduledSessions)
                                        {
                                            <li>
                                                @scheduled.EffectiveStartLocal.ToString("h:mm tt")
                                                @if (scheduled.IsCancelled)
                                                {
                                                    <span class="badge text-bg-danger ms-2">Cancelled</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(scheduled.Note))
                                                {
                                                    <div class="text-white-50 small">@scheduled.Note</div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-lg-7">
                            <div class="border rounded p-3 h-100">
                                <h6 class="mb-2">Transcript Sessions</h6>
                                <div class="list-group list-group-flush">
                                    @foreach (var transcript in day.Transcripts)
                                    {
                                        <a class="list-group-item list-group-item-action" href="/Transcript?sessionId=@transcript.SessionId">
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                <div>
                                                    <div class="fw-semibold">@transcript.StartedLocal.ToString("h:mm tt") • @transcript.SessionId</div>
                                                    <div class="small text-white-50">Speakers: @transcript.ExpectedSpeakers</div>
                                                    @if (transcript.EndedLocal.HasValue)
                                                    {
                                                        <div class="small text-white-50">Ended: @transcript.EndedLocal.Value.ToString("h:mm tt")</div>
                                                    }
                                                </div>
                                                <span class="badge text-bg-secondary">@transcript.Status</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(transcript.Error))
                                            {
                                                <div class="text-warning small mt-1">@transcript.Error</div>
                                            }
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
